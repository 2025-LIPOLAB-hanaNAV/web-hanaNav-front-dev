VITE_RAGFLOW_BASE_URL=http://localhost:xxxx
VITE_RAGFLOW_API_KEY=replace-with-your-key
VITE_RAGFLOW_ASSISTANT_QUICK_ID=
VITE_RAGFLOW_ASSISTANT_PRECISE_ID=
VITE_RAGFLOW_ASSISTANT_SUMMARY_ID=

# Ollama 서버 설정 (LLM as a Judge 품질평가용)
# Vite 프로젝트에서는 VITE_ 접두사 사용

# 로컬 개발환경 기본값
VITE_OLLAMA_URL=http://localhost:11434

# Docker 환경에서 사용할 경우
# VITE_OLLAMA_URL=http://host.docker.internal:11435

# 원격 Ollama 서버 사용할 경우
# VITE_OLLAMA_URL=http://your-ollama-server:11434

# RAG 품질 평가 시스템 설정
VITE_ENABLE_RAG_EVALUATION=true
VITE_OLLAMA_MODEL=gemma3:12b
# Judge 모델 기본값 (없으면 VITE_OLLAMA_MODEL 사용)
# VITE_JUDGE_MODEL=gemma3:12b
# RAG 생성 모델 기본값 (없으면 Judge 모델과 동일)
# VITE_RAG_MODEL=llama3.2:latest

# Dev server config (optional overrides)
DEV_SERVER_HOST=0.0.0.0
DEV_SERVER_PORT=3000
DEV_ALLOWED_HOSTS=localhost
# HMR override (optional). If unset, uses server host/port
# DEV_HMR_HOST=
# DEV_HMR_PORT=
