# Ollama 서버 설정 (LLM as a Judge 품질평가용)
# Vite 프로젝트에서는 VITE_ 접두사 사용

# 로컬 개발환경 기본값
VITE_OLLAMA_URL=http://localhost:11435

# Docker 환경에서 사용할 경우
# VITE_OLLAMA_URL=http://host.docker.internal:11435

# 원격 Ollama 서버 사용할 경우
# VITE_OLLAMA_URL=http://your-ollama-server:11434

# Ollama 인증 정보 (선택사항)
# 토큰 기반 인증을 사용하는 경우
# VITE_OLLAMA_AUTH_TOKEN=your-token-value

# Basic 인증(아이디/비밀번호)을 사용하는 경우
# VITE_OLLAMA_AUTH_USERNAME=ollama
# VITE_OLLAMA_AUTH_PASSWORD=your-password

# Authorization 헤더 전체를 직접 지정하고 싶은 경우 (예: "Authorization: Basic abc123")
# VITE_OLLAMA_AUTH_HEADER=Authorization: Bearer your-token

# RAG 품질 평가 시스템 설정
VITE_ENABLE_RAG_EVALUATION=true
VITE_OLLAMA_MODEL=gemma3:12b
# Judge 모델 기본값 (없으면 VITE_OLLAMA_MODEL 사용)
# VITE_JUDGE_MODEL=gemma3:12b
# RAG 생성 모델 기본값 (없으면 Judge 모델과 동일)
# VITE_RAG_MODEL=gemma3:12b

# RAGFlow API 설정
VITE_RAGFLOW_BASE_URL=http://localhost:18080
VITE_RAGFLOW_API_KEY=ragflow-cyOTFkMjllOTYxNjExZjA5OTBkMDI0Mm
VITE_RAGFLOW_ASSISTANT_QUICK_ID=6d8f48cc90cf11f095a7660c4921b11b # 필요 시 자체 챗앱 ID로 교체
VITE_RAGFLOW_ASSISTANT_PRECISE_ID=71f086c490cf11f09de3660c4921b11b
VITE_RAGFLOW_ASSISTANT_SUMMARY_ID=8029a0ae90cf11f0950d660c4921b11b

# RAGFlow 리랭커 설정 (선택사항)
# VITE_RAGFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# VITE_RAGFLOW_ENABLE_RERANK=true

# 프록시 서버 사용 시 (권장)
VITE_PROXY_BASE_URL=http://localhost:8000
VITE_USE_PROXY=true

# Dev server config (optional overrides)
DEV_SERVER_HOST=0.0.0.0
DEV_SERVER_PORT=18080
DEV_ALLOWED_HOSTS=localhost
# HMR override (optional). If unset, uses server host/port
# DEV_HMR_HOST=
# DEV_HMR_PORT=
